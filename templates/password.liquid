<section class="wrap" style="text-align:center;padding:12vh 5vw">
  <img src="{{ 'echo-logo.png' | asset_url }}" alt="{{ shop.name }}" width="220" height="193" style="margin:auto">
  <h1 class="sh">Drop <em>loading</em></h1>
  <p>{{ shop.password_message | default: 'The merch store opens soon. Follow @echo.tgpcop for the drop.' }}</p>
  {% form 'storefront_password' %}
    <div class="pform" style="max-width:360px;margin:20px auto"><input type="password" name="password" placeholder="Enter password" aria-label="Password"><button class="btn" style="margin-top:12px;width:100%">Enter</button>{{ form.errors | default_errors }}</div>
  {% endform %}
</section>
