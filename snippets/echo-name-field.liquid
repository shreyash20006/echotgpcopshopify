{%- comment -%}
  "Name to print" field saved as a line-item property (shows in cart, order and emails). No app needed.
  Use inside the product form:  {% render 'echo-name-field', product_form_id: product_form_id %}
{%- endcomment -%}
<div class="echo-name">
  <label for="echo-name-{{ section.id }}">Name to print (max 14 letters)</label>
  <input type="text" id="echo-name-{{ section.id }}" name="properties[Name to print]"
         form="{{ product_form_id | default: 'product-form-' | append: section.id }}"
         maxlength="14" required autocomplete="off" placeholder="YOUR NAME"
         oninput="this.value=this.value.toUpperCase().replace(/[^A-Z .]/g,'')">
  <small>Printed exactly as typed. Personalised items can't be returned or exchanged.</small>
</div>
