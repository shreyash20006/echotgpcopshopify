<section class="sec" id="editions">
  <div class="wrap">
    <h2 class="sh">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
    <div class="eds">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c != blank -%}
          <a class="ed rv" href="{{ c.url }}" {{ block.shopify_attributes }}>
            {%- assign img = c.image | default: c.products.first.featured_image -%}
            <div class="edim">{%- if img != blank -%}{{ img | image_url: width: 400 | image_tag: loading: 'lazy', alt: c.title }}{%- else -%}<span class="noimg">ECHO</span>{%- endif -%}</div>
            <b>{{ c.title }}</b><small>{{ c.products_count }} items</small>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Editions", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by" },
  { "type": "text", "id": "accent", "label": "Yellow word", "default": "edition" } ],
  "blocks": [ { "type": "edition", "name": "Edition", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" } ] } ],
  "presets": [ { "name": "Editions" } ] }
{% endschema %}
