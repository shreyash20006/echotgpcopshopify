{%- paginate search.results by 12 -%}
<section class="sec">
  <div class="wrap">
    <h1 class="sh">Search</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="pform" style="max-width:480px;margin-bottom:26px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search merch" aria-label="Search">
    </form>
    {%- if search.performed -%}
      <div class="grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', card_product: item %}{%- else -%}<a class="btn o" href="{{ item.url }}">{{ item.title }}</a>{%- endif -%}
        {%- else -%}<p>No results for “{{ search.terms | escape }}”.</p>{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pager">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
