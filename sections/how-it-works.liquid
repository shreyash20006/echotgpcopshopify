<section class="sec" id="how">
  <div class="wrap">
    <h2 class="sh">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
    <div class="how">
      {%- for block in section.blocks -%}<div class="rv" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b>{{ block.settings.text }}</div>{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "How it works", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "How it" },
  { "type": "text", "id": "accent", "label": "Yellow word", "default": "works" } ],
  "blocks": [ { "type": "step", "name": "Step", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "1. Pay now" },
    { "type": "textarea", "id": "text", "label": "Text" } ] } ],
  "presets": [ { "name": "How it works" } ] }
{% endschema %}
