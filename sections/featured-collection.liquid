{%- assign col = section.settings.collection -%}
{%- assign product_list = col.products -%}
{%- if col == blank or product_list == blank or product_list.size == 0 -%}
  {%- assign product_list = collections.all.products -%}
{%- endif -%}
<section class="sec" id="shop">
  <div class="wrap">
    <h2 class="sh">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
    <div class="chips">
      <a class="on" href="{{ routes.all_products_collection_url }}">All</a>
      {%- for block in section.blocks -%}{%- if block.settings.collection != blank -%}<a href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>{{ block.settings.collection.title }}</a>{%- endif -%}{%- endfor -%}
    </div>
    <div class="grid">
      {%- for product in product_list limit: section.settings.limit -%}
        {% render 'product-card', card_product: product %}
      {%- else -%}
        <div style="grid-column: 1 / -1; text-align: center; padding: 48px 16px; background: rgba(0, 0, 0, 0.15); border-radius: 16px; border: 2px dashed rgba(255, 255, 255, 0.2);">
          <p style="font-size: 1.25rem; font-weight: 700; margin: 0 0 8px;">No active products visible yet</p>
          <p style="font-size: 0.95rem; opacity: 0.85; max-width: 500px; margin: 0 auto; line-height: 1.5;">Make sure in Shopify Admin that your product status is <strong>Active</strong> and <strong>Online Store</strong> is selected under Sales Channels.</p>
        </div>
      {%- endfor -%}
    </div>
    <p style="text-align:center;margin-top:28px"><a class="btn" href="{{ routes.all_products_collection_url }}">View all products</a></p>
  </div>
</section>
{% schema %}
{ "name": "Product grid", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
  { "type": "text", "id": "accent", "label": "Yellow word", "default": "all" },
  { "type": "collection", "id": "collection", "label": "Collection (empty = all products)" },
  { "type": "range", "id": "limit", "min": 4, "max": 24, "step": 2, "label": "Products to show", "default": 8 } ],
  "blocks": [ { "type": "chip", "name": "Category link", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" } ] } ],
  "presets": [ { "name": "Product grid" } ] }
{% endschema %}
