<div class="ticker" role="marquee" aria-label="{{ section.settings.text | escape }}">
  <div class="ticker__in">{%- for i in (1..16) -%}<span>{{ section.settings.text }}</span>{%- endfor -%}</div>
</div>
{% schema %}
{ "name": "Ticker", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "ECHO.TGPCOP × TGPCOP STUDENTS COUNCIL ×" } ] }
{% endschema %}
