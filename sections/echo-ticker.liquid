<div class="echo-ticker" role="marquee" aria-label="{{ section.settings.text | escape }}">
  <div class="echo-ticker__in">
    {%- for i in (1..16) -%}<span>{{ section.settings.text }}</span><span>•</span>{%- endfor -%}
  </div>
</div>
{% schema %}
{ "name": "Echo ticker", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "ECHO.TGPCOP × TGPCOP STUDENTS COUNCIL ×" } ], "presets": [ { "name": "Echo ticker" } ] }
{% endschema %}
