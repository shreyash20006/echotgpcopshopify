<section class="sec collab" id="collab">
  <div class="wrap">
    <h2 class="sh" style="color:var(--yellow)">{{ section.settings.kicker }}</h2>
    <div class="row rv">
      {%- if section.settings.council != blank -%}{{ section.settings.council | image_url: width: 400 | image_tag: alt: 'TGPCOP Students Council', loading: 'lazy' }}{%- else -%}<img src="{{ 'council-logo.png' | asset_url }}" alt="TGPCOP Students Council" width="160" height="160" loading="lazy">{%- endif -%}
      <div class="x">×</div>
      {%- capture logo_url %}{% render 'logo-url' %}{% endcapture -%}
      <img class="d" src="{{ logo_url }}" alt="Echo.TGPCOP Media" width="160" height="160" loading="lazy">
      <div class="x">×</div>
      {%- if section.settings.nss != blank -%}{{ section.settings.nss | image_url: width: 400 | image_tag: alt: 'NSS TGPCOP', loading: 'lazy' }}{%- else -%}<img src="{{ 'nss-logo.png' | asset_url }}" alt="NSS TGPCOP" width="160" height="160" loading="lazy">{%- endif -%}
    </div>
    <div class="big2">Lead • Learn <em>Capture</em></div>
    <p class="handles">
      <a href="https://instagram.com/{{ settings.ig_council | default: 'tgpcop.council' }}">@{{ settings.ig_council | default: 'tgpcop.council' }}</a> ×
      <a href="https://instagram.com/{{ settings.ig_echo | default: 'echo.tgpcop' }}">@{{ settings.ig_echo | default: 'echo.tgpcop' }}</a> ×
      <a href="https://instagram.com/{{ settings.ig_nss | default: 'nss_tgpcop' }}">@{{ settings.ig_nss | default: 'nss_tgpcop' }}</a>
    </p>
  </div>
</section>
{% schema %}
{ "name": "Collaboration", "settings": [
  { "type": "text", "id": "kicker", "label": "Heading", "default": "In collaboration" },
  { "type": "image_picker", "id": "council", "label": "Council logo (optional)" },
  { "type": "image_picker", "id": "nss", "label": "NSS logo (optional)" } ],
  "presets": [ { "name": "Collaboration" } ] }
{% endschema %}
